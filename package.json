{
  "name": "typescript-boilerplate",
  "version": "1.6.2",
  "main": "src/main.ts",
  "scripts": {
    "start": "npx tsx ./src/main.ts",
    "lint": "cross-env TIMING=1 npx eslint",
    "lint:fix": "npm run lint -- --fix",
    "lint:debug": "npm run lint -- --debug",
    "format:md": "npx prettier --write \"**/*.md\"",
    "typecheck": "node ./node_modules/typescript-7/bin/tsc --noEmit",
    "test": "npx vitest",
    "test:run": "npx vitest run",
    "test:coverage": "npx vitest run --coverage",
    "bump-version": "npx tsx ./scripts/bump-version.script.ts && npm audit fix",
    "parse-llm-response": "npx tsx ./scripts/split-plain-code.wrap.ts",
    "after-parse-llm-response": "npx tsx ./scripts/create-auto-ts-paths.script.ts && npm run lint:fix && npm run format:md",
    "format": "npx prettier . --write",
    "generate:env-template": "npx tsx ./scripts/generate-env-template.ts",
    "postinstall": "./scripts/link-codex-skills.sh"
  },
  "keywords": [
    "typescript",
    "boilerplate",
    "eslint",
    "prettier",
    "modern",
    "vitest",
    "template"
  ],
  "author": "Dmytro Vakulenko",
  "license": "ISC",
  "description": "Modern, scalable TypeScript boilerplate for Node.js projects with strict linting, Prettier formatting, modular structure, and Vitest testing.",
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@darraghor/eslint-plugin-nestjs-typed": "^7.5.8",
    "@dword-design/eslint-plugin-import-alias": "^8.1.8",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "cross-env": "^10.1.0",
    "deepmerge": "^4.3.1",
    "eslint": "^10.14.0",
    "eslint-config-naming": "^1.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.4.1",
    "eslint-plugin-depend": "^1.5.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-import-zod": "^1.2.1",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-lintlord": "^1.2.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-no-barrel-files": "^2.3.0",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-zod": "^5.2.2",
    "globals": "^17.14.0",
    "json5": "^2.2.3",
    "prettier": "^3.9.10",
    "ts-declaration-location": "^1.0.7",
    "type-fest": "^5.10.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.21.0 || >=24.10.0"
  },
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git@github-personal:DrSmile444/typescript-boilerplate.git"
  }
}
